@page
@model IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "ЭС";
}

<div class="container text-center">
    <h2>
        Свод правил
    </h2>
</div>
<hr>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="container text-left">
    @if (Model.RuleSets.Count == 0)
    {
        <p class="text-center text-muted">Правил пока нет. Нажмите «Добавить правило».</p>
    }

    @for (int i = (Model.PageNumber - 1) * Model.PageSize; i < Math.Min(Model.PageNumber * Model.PageSize, Model.RuleSets.Count); i++)
    {
        var rs = Model.RuleSets[i];
        string data = JsonSerializer.Serialize(new
        {
            index = i,
            conditions = rs.Conditions.Select(c => new { obj = c.Object, val = c.Value }),
            consequence = new { obj = rs.Consequence.Object, val = rs.Consequence.Value }
        });

        <div class="container ruleset-card" id="rs-@(i + 1)" data-index="@i" data-rule="@data">
            <p class="text-center">
                Правило #@(i + 1)
            </p>
            @for (int j = 0; j < rs.Conditions.Count; j++)
            {
                <p>@(j == 0 ? "ЕСЛИ" : "И")</p>
                <input type="text" value="@rs.Conditions[j].Object = @rs.Conditions[j].Value" readonly>
            }
            <p>
                ТО
            </p>
            <input type="text" value="@rs.Consequence.Object = @rs.Consequence.Value" readonly>
        </div>
    }
</div>

<form method="get" class="container d-flex justify-content-center align-items-center gap-2 mb-3">
    <a class="btn btn-sm btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")"
       asp-page="/Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-PageSize="@Model.PageSize">&laquo;</a>
    <span>Страница @Model.PageNumber из @Model.PageCount</span>
    <a class="btn btn-sm btn-outline-secondary @(Model.PageNumber >= Model.PageCount ? "disabled" : "")"
       asp-page="/Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-PageSize="@Model.PageSize">&raquo;</a>
    <label class="ms-3" for="page-size">На странице:</label>
    <select class="form-select form-select-sm w-auto" name="PageSize" id="page-size" onchange="this.form.submit()">
        @foreach (int size in IndexModel.PageSizes)
        {
            <option value="@size" selected="@(size == Model.PageSize)">@size</option>
        }
    </select>
</form>

<div class="container text-center mb-1">
    <button type="button" class="btn btn-outline-primary" id="btn-add-rule">
        Добавить правило
    </button>
    <button type="button" class="btn btn-outline-secondary" id="btn-edit-rule" disabled>
        Редактировать правило
    </button>
    <button type="button" class="btn btn-outline-danger" id="btn-remove-rule" disabled>
        Удалить правило
    </button>
</div>
<div class="container text-center mb-1">
    <button type="button" class="btn btn-outline-dark" id="btn-import-rules">
        Импорт правил
    </button>
    <a class="btn btn-outline-dark" asp-page-handler="Export">
        Экспорт правил
    </a>
</div>
<div class="container text-center mb-3">
    <a class="btn btn-success" asp-page="/Inference">
        Запустить вывод &rarr;
    </a>
</div>

@* import form: the file input is opened by the button above *@
<form method="post" asp-page-handler="Import" enctype="multipart/form-data" id="form-import" hidden>
    <input type="file" name="file" id="import-file" accept=".rs,.json,application/json">
</form>

@* deleting selected rule form *@
<form method="post" asp-page-handler="Delete" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" id="form-delete">
    <input type="hidden" name="index" id="delete-index">
</form>

@* add/edit modal *@
<div class="modal fade" id="rule-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Save" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" class="modal-content" id="form-save">
            <div class="modal-header">
                <h5 class="modal-title" id="rule-modal-title">Правило</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Input.Index" id="input-index">

                <div id="conditions"></div>
                <button type="button" class="btn btn-sm btn-outline-primary mb-3" id="btn-add-condition">
                    + условие (И)
                </button>

                <p class="mb-1 fst-italic fw-medium">ТО</p>
                <div class="input-group">
                    <input type="text" class="form-control" name="Input.Consequence.Object" id="cons-object"
                           placeholder="Объект" required>
                    <span class="input-group-text">=</span>
                    <input type="text" class="form-control" name="Input.Consequence.Value" id="cons-value"
                           placeholder="Значение" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/rules.js" asp-append-version="true"></script>
}
